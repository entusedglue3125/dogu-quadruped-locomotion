#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "dogu"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "dogu" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "fl_hip_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "fr_hip_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "bl_hip_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "br_hip_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "fl_femur_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "fl_tibia_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "fr_femur_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "fr_tibia_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "bl_femur_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "bl_tibia_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "br_femur_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "br_tibia_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "fl_hip_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "fl_femur_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "fl_tibia_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                    }
                }
            }

            over "fr_hip_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "fr_femur_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "fr_tibia_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                    }
                }
            }

            over "bl_hip_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "bl_femur_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "bl_tibia_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                    }
                }
            }

            over "br_hip_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "br_femur_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "br_tibia_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                    }
                }
            }
        }
    }
}

