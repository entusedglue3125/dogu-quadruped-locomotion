#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "dogu_base" (
        prepend references = @./geometries.usd@</Geometries/dogu_base>
    )
    {
        over "dogu_base" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/dogu_base/VisualMaterials/dogu_base>
        }

        def Scope "VisualMaterials"
        {
            def Material "dogu_base" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/dogu_base>
            )
            {
            }
        }
    }

    def Xform "dogu_base_1" (
        prepend references = @./geometries.usd@</Geometries/dogu_base>
    )
    {
        over "dogu_base" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }

