        {
            uniform double mjc:forceRange:max = 2
            uniform double mjc:forceRange:min = -2
            custom rel mjc:target
            append rel mjc:target = </dogu/Physics/fr_tibia_joint>
        }

        def MjcActuator "bl_hip_joint_actuator"
        {
            uniform double mjc:forceRange:max = 2
            uniform double mjc:forceRange:min = -2
            custom rel mjc:target
            append rel mjc:target = </dogu/Physics/bl_hip_joint>
        }

        def MjcActuator "bl_femur_joint_actuator"
        {
            uniform double mjc:forceRange:max = 2
            uniform double mjc:forceRange:min = -2
            custom rel mjc:target
            append rel mjc:target = </dogu/Physics/bl_femur_joint>
        }

        def MjcActuator "bl_tibia_joint_actuator"
        {
