            uniform double mjc:forceRange:min = -2
            custom rel mjc:target
            append rel mjc:target = </dogu/Physics/bl_tibia_joint>
        }

        def MjcActuator "br_hip_joint_actuator"
        {
            uniform double mjc:forceRange:max = 2
            uniform double mjc:forceRange:min = -2
            custom rel mjc:target
            append rel mjc:target = </dogu/Physics/br_hip_joint>
        }

        def MjcActuator "br_femur_joint_actuator"
        {
            uniform double mjc:forceRange:max = 2
            uniform double mjc:forceRange:min = -2
            custom rel mjc:target
            append rel mjc:target = </dogu/Physics/br_femur_joint>
        }

        def MjcActuator "br_tibia_joint_actuator"
        {
            uniform double mjc:forceRange:max = 2
            uniform double mjc:forceRange:min = -2
            custom rel mjc:target
            append rel mjc:target = </dogu/Physics/br_tibia_joint>
